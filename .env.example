# ============================================================
# VITian Chatbot Local POC — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# LLM Provider
# ----------------------------------------------------------

# Name of the LLM provider to use (e.g. "openai", "anthropic", "google", "ollama")
LLM_PROVIDER=openai

# Name of the environment variable that holds the provider's API key.
# The app reads os.environ[LLM_API_KEY_ENV] at runtime, NOT this variable directly.
# This indirection lets you keep the actual key in a secrets manager or a separate
# env var without hardcoding the variable name in config.
LLM_API_KEY_ENV=OPENAI_API_KEY

# The actual API key referenced above (set this too, or export it separately)
OPENAI_API_KEY=sk-...

# Fully-qualified model name / version string.
# This string is recorded verbatim in every results CSV row.
# Example values: "gpt-4o-2024-05-13", "claude-3-5-sonnet-20241022", "gemini-1.5-pro"
LLM_MODEL_NAME=gpt-4o-2024-05-13

# Sampling temperature for evaluation runs.
# Keep at 0 (or as close to deterministic as the provider allows) for all
# experiment runs.  Only raise for demos / exploratory use.
LLM_TEMPERATURE=0.0

# ----------------------------------------------------------
# Embeddings
# ----------------------------------------------------------

# Name of the sentence-transformers model used for local embeddings.
# This model is downloaded from HuggingFace on first run and cached locally.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------

# PostgreSQL connection URL.
# Docker Compose default (matches docker-compose.yml):
DATABASE_URL=postgresql://vitian:vitian_pw@localhost:5432/vitian_chatbot

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------

# Directory where ChromaDB persists its local vector store.
# Must be a path writable by the app process.
CHROMA_PERSIST_DIR=./chroma_data

# Directory where rotating log files are written.
LOG_DIR=./logs

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
